# Copy to .env and fill in your keys. Sources without a key are disabled.
# These are read server-side only (nginx proxy in Docker, Vite proxy in dev)
# and never end up in the browser bundle.

# https://open-platform.theguardian.com/access
GUARDIAN_API_KEY=

# https://developer.nytimes.com (enable "Article Search API" for your app)
NYT_API_KEY=

# https://newsapi.org/register
NEWSAPI_API_KEY=

# Host port for `docker compose up` (default 8080).
# PORT=8080
